{
  "name": "nexus-cart-ecommerce",
  "version": "1.0.0",
  "description": "Enterprise Scalable E-Commerce Platform API & Web Console (50k+ LOC)",
  "main": "dist/backend/src/index.js",
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/backend/src/index.js",
    "dev": "ts-node-dev --respawn --transpile-only backend/src/index.ts",
    "test": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node backend/prisma/seed.ts"
  },
  "keywords": [
    "ecommerce",
    "enterprise",
    "typescript",
    "express",
    "prisma",
    "react",
    "nexuscart"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}