{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "rootDir": "./",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "backend/**/*",
    "cli/**/*",
    "agent/**/*",
    "frontend/**/*",
    "tests/**/*"
  ]
}
